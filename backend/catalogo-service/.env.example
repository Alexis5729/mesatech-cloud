# Este archivo documenta las variables requeridas.
# Spring Boot no carga .env automáticamente: exporta estas variables o usa
# EnvironmentFile en systemd durante el despliegue.

CATALOGO_PORT=8082
CATALOGO_DB_URL=jdbc:postgresql://localhost:5432/mesatech_catalogo
CATALOGO_DB_USERNAME=mesatech_catalogo_app
CATALOGO_DB_PASSWORD=CAMBIAR_EN_CADA_ENTORNO
JPA_DDL_AUTO=validate

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=mesatech
RABBITMQ_USERNAME=catalogo-publisher
RABBITMQ_PASSWORD=CAMBIAR_EN_CADA_ENTORNO
